{
    "name": "gsferro/filament-odometer-easy",
    "description": "Animated counters for Filament v3, v4 and v5 — tables, infolists, stats and navigation badges — powered by number-flow (default) or odometer.js.",
    "keywords": [
        "gsferro",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-odometer-easy",
        "odometer",
        "number-flow",
        "counter",
        "animation",
        "dashboard"
    ],
    "homepage": "https://github.com/gsferro/filament-odometer-easy",
    "support": {
        "issues": "https://github.com/gsferro/filament-odometer-easy/issues",
        "source": "https://github.com/gsferro/filament-odometer-easy"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "gsferro",
            "email": "g_santana26@yahoo.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2|^4.0|^5.0",
        "gsferro/odometer-easy": "^1.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gsferro\\FilamentOdometerEasy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gsferro\\FilamentOdometerEasy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsferro\\FilamentOdometerEasy\\FilamentOdometerEasyServiceProvider"
            ],
            "aliases": {
                "FilamentOdometerEasy": "Gsferro\\FilamentOdometerEasy\\Facades\\FilamentOdometerEasy"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
